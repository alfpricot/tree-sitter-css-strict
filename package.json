{
  "name": "tree-sitter-css-strict",
  "version": "0.1.3",
  "description": "Strict CSS grammar for tree-sitter",
  "main": "bindings/node",
  "types": "bindings/node",
  "scripts": {
    "install": "node-gyp-build",
    "prestart": "npx --yes --package=tree-sitter-cli@0.27.1 -- tree-sitter build --wasm",
    "start": "npx --yes --package=tree-sitter-cli@0.27.1 -- tree-sitter playground",
    "test": "node --test bindings/node/*_test.js",
    "lint": "oxlint grammar.js test tools bindings/node",
    "format": "oxfmt grammar.js \"test/*.mjs\" \"tools/*.mjs\" \"bindings/node/*.js\"",
    "format:check": "oxfmt --check grammar.js \"test/*.mjs\" \"tools/*.mjs\" \"bindings/node/*.js\""
  },
  "author": "M. Reifschneider",
  "contributors": [
    "Max Brunsfeld",
    "Amaan Qureshi"
  ],
  "license": "MIT",
  "dependencies": {
    "node-addon-api": "8.9.2",
    "node-gyp-build": "4.8.4"
  },
  "devDependencies": {
    "node-gyp": "13.1.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "tree-sitter": "0.25.1",
    "tree-sitter-cli": "0.27.1"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "gypfile": true,
  "directories": {
    "test": "test"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alfpricot/tree-sitter-css-strict.git"
  },
  "bugs": {
    "url": "https://github.com/alfpricot/tree-sitter-css-strict/issues"
  },
  "homepage": "https://github.com/alfpricot/tree-sitter-css-strict#readme",
  "keywords": [
    "parser",
    "css",
    "tree-sitter",
    "strict"
  ],
  "files": [
    "grammar.js",
    "binding.gyp",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "prebuilds/**",
    "tree-sitter.json",
    "NOTICE"
  ],
  "allowScripts": {
    "tree-sitter-cli@0.27.1": true,
    "tree-sitter@0.25.1": true
  }
}
